# Copy to `.env` and fill in only what you need:   cp .env.example .env
# NEVER commit a real .env file or put real credentials in this file.

# demo = nothing is published, no credentials needed (default)
# live = real posts through the official platform APIs
POSTING_MODE=live

# --- Bluesky (live mode) ---  Settings > Privacy and security > App Passwords
BLUESKY_HANDLE=https://bsky.app/profile/jainam-147.bsky.social
BLUESKY_APP_PASSWORD= xxxx-xxxx-xxxx-xxxx

# --- Mastodon (live mode) --- e.g. https://mastodon.social ; token needs the write:statuses scope
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=

# --- DEV.to (live mode) ---  Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# --- Hashnode (live mode) --- Personal Access Token + the Publication ID of your blog
HASHNODE_API_KEY=
HASHNODE_PUBLICATION_ID=

# --- WordPress (live mode) --- self-hosted site URL, username, Application Password
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Optional tuning (defaults shown) ---
# PLATFORM_TIMEOUT_SECONDS=30      # max time for ONE platform (publish + public check)
# HTTP_TIMEOUT_SECONDS=15          # timeout of each HTTP request
# PUBLIC_CHECK_ATTEMPTS=3          # anonymous "is it public?" checks after publishing
# PUBLIC_CHECK_DELAY_SECONDS=1.5
